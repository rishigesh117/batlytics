<CaptainSpinnerOption@SpinnerOption>:
    background_normal: ''
    background_color: 1, 1, 1, 1
    color: 0.1, 0.1, 0.1, 1
    font_size: '15sp'
    height: dp(44)

<MatchSetupScreen>:
    name: 'match_setup'
    canvas.before:
        Color:
            rgba: 0.96, 0.96, 0.94, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(64)
            padding: [dp(20), dp(10), dp(20), dp(10)]
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Button:
                text: '<'
                font_size: '24sp'
                color: 0.1, 0.1, 0.1, 1
                background_normal: ''
                background_color: 0, 0, 0, 0
                size_hint_x: None
                width: dp(48)
                on_release: root.manager.current = 'home'
            Label:
                text: 'New Match Setup'
                font_size: '18sp'
                bold: True
                color: 0.1, 0.1, 0.1, 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'

        ScrollView:
            id: setup_scroll
            do_scroll_x: False
            scroll_type: ['bars', 'content']
            bar_width: dp(4)
            bar_color: 0.18, 0.49, 0.20, 0.6
            bar_inactive_color: 0.18, 0.49, 0.20, 0.2
            effect_cls: 'DampedScrollEffect'
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(16), dp(20), dp(16)]
                spacing: dp(16)

                Label:
                    text: 'Configure your teams and match settings to begin scoring.'
                    font_size: '13sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: dp(32)
                    halign: 'left'
                    text_size: self.size

                # Team A
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(12), dp(12), dp(12), dp(12)]
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    Label:
                        text: 'Team A'
                        font_size: '14sp'
                        color: 0.18, 0.49, 0.20, 1
                        bold: True
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)
                    TextInput:
                        text: root.team_a_name
                        hint_text: 'Enter Team Name'
                        multiline: False
                        write_tab: False
                        font_size: '16sp'
                        size_hint_y: None
                        height: dp(48)
                        background_color: 0.96, 0.96, 0.94, 1
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        on_text: root.team_a_name = self.text
                        on_focus: if not self.focus: root.autofill_team(self.text, 'a')

                # Team B
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(12), dp(12), dp(12), dp(12)]
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    Label:
                        text: 'Team B'
                        font_size: '14sp'
                        color: 0.96, 0.49, 0, 1
                        bold: True
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)
                    TextInput:
                        text: root.team_b_name
                        hint_text: 'Enter Team Name'
                        multiline: False
                        write_tab: False
                        font_size: '16sp'
                        size_hint_y: None
                        height: dp(48)
                        background_color: 0.96, 0.96, 0.94, 1
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        on_text: root.team_b_name = self.text
                        on_focus: if not self.focus: root.autofill_team(self.text, 'b')

                # Match Duration
                BoxLayout:
                    size_hint_y: None
                    height: dp(80)
                    spacing: dp(8)
                    padding: [dp(12), dp(8), dp(12), dp(8)]
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.49, 0.20, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Overs per Innings'
                            font_size: '12sp'
                            color: 0.7, 1, 0.7, 1
                            halign: 'left'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(20)
                        BoxLayout:
                            Button:
                                text: '-'
                                font_size: '24sp'
                                color: 1, 1, 1, 1
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                size_hint_x: None
                                width: dp(48)
                                on_release: root.decrease_overs()
                            Button:
                                text: str(root.num_overs)
                                font_size: '28sp'
                                bold: True
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                color: 1, 1, 1, 1
                                on_release: root.edit_overs()
                            Label:
                                text: 'Overs'
                                font_size: '14sp'
                                color: 0.8, 1, 0.8, 1
                            Button:
                                text: '+'
                                font_size: '24sp'
                                color: 1, 1, 1, 1
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                size_hint_x: None
                                width: dp(48)
                                on_release: root.increase_overs()

                # Bowler Limit
                BoxLayout:
                    size_hint_y: None
                    height: dp(70)
                    spacing: dp(8)
                    padding: [dp(12), dp(8), dp(12), dp(8)]
                    canvas.before:
                        Color:
                            rgba: 0.1, 0.4, 0.6, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Bowler Limit'
                            font_size: '12sp'
                            color: 0.7, 0.9, 1, 1
                            halign: 'left'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(20)
                        BoxLayout:
                            Button:
                                text: '-'
                                font_size: '24sp'
                                color: 1, 1, 1, 1
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                size_hint_x: None
                                width: dp(48)
                                on_release: root.decrease_limit()
                            Button:
                                text: str(root.bowler_limit)
                                font_size: '28sp'
                                bold: True
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                color: 1, 1, 1, 1
                                on_release: root.edit_limit()
                            Label:
                                text: 'Max'
                                font_size: '14sp'
                                color: 0.8, 1, 0.8, 1
                            Button:
                                text: '+'
                                font_size: '24sp'
                                color: 1, 1, 1, 1
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                size_hint_x: None
                                width: dp(48)
                                on_release: root.increase_limit()

                # Players count
                BoxLayout:
                    size_hint_y: None
                    height: dp(70)
                    spacing: dp(8)
                    padding: [dp(12), dp(8), dp(12), dp(8)]
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    Label:
                        text: 'Squad Size'
                        font_size: '14sp'
                        color: 0.3, 0.3, 0.3, 1
                        halign: 'left'
                        text_size: self.size
                    Button:
                        text: '-'
                        font_size: '24sp'
                        color: 0.3, 0.3, 0.3, 1
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        size_hint_x: None
                        width: dp(48)
                        on_release: root.decrease_players()
                    Button:
                        text: str(root.num_players)
                        font_size: '24sp'
                        bold: True
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        color: 0.1, 0.1, 0.1, 1
                        size_hint_x: None
                        width: dp(50)
                        on_release: root.edit_players()
                    Label:
                        text: 'Players'
                        font_size: '14sp'
                        color: 0.5, 0.5, 0.5, 1
                        size_hint_x: None
                        width: dp(60)
                    Button:
                        text: '+'
                        font_size: '24sp'
                        color: 0.3, 0.3, 0.3, 1
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        size_hint_x: None
                        width: dp(48)
                        on_release: root.increase_players()

                # Team A Squad
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(32)
                        Label:
                            text: 'Team A Squad'
                            font_size: '15sp'
                            bold: True
                            color: 0.18, 0.49, 0.20, 1
                            halign: 'left'
                            text_size: self.size

                    # Team A Captain Spinner (at TOP)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(10)
                        padding: [dp(10), dp(2), dp(10), dp(2)]
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(6)]
                            Color:
                                rgba: 0.18, 0.49, 0.20, 0.4
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(6)]
                                width: dp(1)
                        Label:
                            text: 'Captain:'
                            font_size: '14sp'
                            bold: True
                            color: 0.18, 0.49, 0.20, 1
                            size_hint_x: None
                            width: dp(65)
                        Spinner:
                            id: team_a_captain_spinner
                            text: root.team_a_captain
                            values: root.team_a_player_names
                            font_size: '15sp'
                            bold: True
                            color: 0.1, 0.1, 0.1, 1
                            background_normal: ''
                            background_color: 0.95, 0.97, 0.95, 1
                            option_cls: 'CaptainSpinnerOption'
                            on_text: root.team_a_captain = self.text

                    BoxLayout:
                        orientation: 'vertical'
                        id: team_a_container
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)

                # Team B Squad
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(32)
                        Label:
                            text: 'Team B Squad'
                            font_size: '15sp'
                            bold: True
                            color: 0.96, 0.49, 0, 1
                            halign: 'left'
                            text_size: self.size

                    # Team B Captain Spinner (at TOP)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(10)
                        padding: [dp(10), dp(2), dp(10), dp(2)]
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(6)]
                            Color:
                                rgba: 0.96, 0.49, 0, 0.4
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(6)]
                                width: dp(1)
                        Label:
                            text: 'Captain:'
                            font_size: '14sp'
                            bold: True
                            color: 0.96, 0.49, 0, 1
                            size_hint_x: None
                            width: dp(65)
                        Spinner:
                            id: team_b_captain_spinner
                            text: root.team_b_captain
                            values: root.team_b_player_names
                            font_size: '15sp'
                            bold: True
                            color: 0.1, 0.1, 0.1, 1
                            background_normal: ''
                            background_color: 0.99, 0.97, 0.94, 1
                            option_cls: 'CaptainSpinnerOption'
                            on_text: root.team_b_captain = self.text

                    BoxLayout:
                        orientation: 'vertical'
                        id: team_b_container
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)

                # Dynamic keyboard spacer — grows when keyboard opens
                # so content can scroll above the keyboard
                Widget:
                    id: keyboard_spacer
                    size_hint_y: None
                    height: dp(100)

        # Bottom bar — Next button
        BoxLayout:
            size_hint_y: None
            height: dp(72)
            padding: [dp(20), dp(10), dp(20), dp(10)]
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'Configuration Pending'
                font_size: '12sp'
                color: 0.5, 0.5, 0.5, 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'
            Button:
                text: 'Next >'
                font_size: '16sp'
                bold: True
                size_hint_x: None
                width: dp(120)
                background_normal: ''
                background_color: 0.18, 0.49, 0.20, 1
                color: 1, 1, 1, 1
                on_release: root.proceed_to_toss()
